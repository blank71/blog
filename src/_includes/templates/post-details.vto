<div class="post-details">
  {{ if author }}
    {{ set page = search.page(`type=author author="author"`) }}
    {{ if page }}
      <address class="post-author">{{ i18n.post.by}} <a data-pagefind-filter="author" rel="author" href="{{ page.url }}">{{ author }}</a></address>
    {{ else }}
      <address class="post-author">{{ i18n.post.by}} {{ author }}</address>
    {{ /if }}
  {{ /if }}

  <time datetime="{{ date |> date('DATETIME', "ja") }}">
    {{ date |> date('DATE') }}
  </time>
  
  <div class="post-tags">
    {{ for tag of tags }}
      {{ set page = search.page(`type=tag tag="${tag}"`) }}

      {{ if page }}
        <a data-pagefind-filter="filter" class="badge" href="{{ page.url }}">{{ tag }}</a>
      {{ /if }}
    {{ /for }}
  </div>
</div>
